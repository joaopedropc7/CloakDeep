[
  {
    "name": "theme_info",
    "theme_name": "Giveaway",
    "theme_version": "1.0.0",
    "theme_author": "Custom",
    "theme_documentation_url": "https://shopify.dev/docs/storefronts/themes",
    "theme_support_url": "https://help.shopify.com"
  },
  {
    "name": "Marca",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo_mark",
        "label": "Emblema (versão cinza do logo)",
        "info": "Usado na barra de abas da página do sorteio."
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Cores",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Fundo",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Texto",
        "default": "#1A1A1A"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Texto secundário",
        "default": "#6B6B6B"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Destaque (botões e selos)",
        "default": "#C8202F"
      },
      {
        "type": "color",
        "id": "color_price",
        "label": "Preços",
        "default": "#24479B"
      },
      {
        "type": "color",
        "id": "color_link",
        "label": "Links",
        "default": "#24479B"
      },
      {
        "type": "color",
        "id": "color_success",
        "label": "Botão do cupom",
        "default": "#2E8B57"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Fundo de painéis",
        "default": "#F5F5F5"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Bordas",
        "default": "#E3E3E3"
      }
    ]
  },
  {
    "name": "Tipografia",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Títulos",
        "default": "poppins_n6"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Texto",
        "default": "poppins_n4"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Largura da página",
        "min": 1000,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "default": 1160
      },
      {
        "type": "range",
        "id": "card_radius",
        "label": "Arredondamento dos cards",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "default": 12
      }
    ]
  },
  {
    "name": "Sorteios",
    "settings": [
      {
        "type": "select",
        "id": "buy_redirect",
        "label": "Ao clicar em um pacote de tickets",
        "options": [
          {
            "value": "drawer",
            "label": "Abrir carrinho lateral"
          },
          {
            "value": "checkout",
            "label": "Ir direto para o checkout"
          },
          {
            "value": "cart",
            "label": "Ir para a página do carrinho"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "text",
        "id": "date_format",
        "label": "Formato de data",
        "default": "%B %d, %Y",
        "info": "Ex.: %d/%m/%Y ou %B %d, %Y"
      },
      {
        "type": "text",
        "id": "ended_label",
        "label": "Texto de sorteio encerrado",
        "default": "Closed"
      },
      {
        "type": "text",
        "id": "cd_days",
        "label": "Contagem: dias",
        "default": "Days"
      },
      {
        "type": "text",
        "id": "cd_hours",
        "label": "Contagem: horas",
        "default": "Hrs"
      },
      {
        "type": "text",
        "id": "cd_minutes",
        "label": "Contagem: minutos",
        "default": "Min"
      },
      {
        "type": "text",
        "id": "cd_seconds",
        "label": "Contagem: segundos",
        "default": "Sec"
      }
    ]
  },
  {
    "name": "Redes sociais",
    "settings": [
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook"
      },
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram"
      },
      {
        "type": "text",
        "id": "social_pinterest",
        "label": "Pinterest"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok"
      },
      {
        "type": "text",
        "id": "social_x",
        "label": "X (Twitter)"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube"
      }
    ]
  },
  {
    "name": "Carrinho lateral",
    "settings": [
      {
        "type": "text",
        "id": "drawer_title",
        "label": "Título",
        "default": "Your ticket(s) have been added to the cart!"
      },
      {
        "type": "text",
        "id": "drawer_draw_label",
        "label": "Rótulo da data do sorteio",
        "default": "Draw Date (on/about):"
      },
      {
        "type": "text",
        "id": "drawer_number_label",
        "label": "Rótulo do número",
        "default": "Giveaway No."
      },
      {
        "type": "text",
        "id": "drawer_more",
        "label": "Botão continuar",
        "default": "GRAB MORE TICKETS"
      },
      {
        "type": "text",
        "id": "drawer_cart",
        "label": "Botão carrinho",
        "default": "GO TO CART"
      },
      {
        "type": "text",
        "id": "drawer_empty",
        "label": "Texto de carrinho vazio",
        "default": "Your cart is empty."
      }
    ]
  }
]
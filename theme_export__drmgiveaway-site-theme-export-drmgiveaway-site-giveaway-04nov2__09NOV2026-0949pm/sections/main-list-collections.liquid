<section class="section container">
  <h1 class="section-title">{{ page_title }}</h1>
  <div class="grid grid--3">
    {%- for collection in collections -%}
      <article class="gcard">
        <a class="gcard__media" href="{{ collection.url }}">
          {%- if collection.featured_image -%}{{ collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy' }}{%- else -%}{{ 'collection-1' | placeholder_svg_tag: 'gcard__placeholder' }}{%- endif -%}
        </a>
        <div class="gcard__body"><h3 class="gcard__title"><a href="{{ collection.url }}">{{ collection.title }}</a></h3></div>
      </article>
    {%- endfor -%}
  </div>
</section>
{% schema %}{ "name": "Lista de coleções", "settings": [] }{% endschema %}

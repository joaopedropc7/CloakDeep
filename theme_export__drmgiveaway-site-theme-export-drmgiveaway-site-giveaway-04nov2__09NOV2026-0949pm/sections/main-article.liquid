<article class="section container page-narrow">
  <p class="muted">{{ article.published_at | date: settings.date_format }}</p>
  <h1 class="section-title">{{ article.title }}</h1>
  {%- if article.image -%}<div class="article-image">{{ article.image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '600,1000,1600' }}</div>{%- endif -%}
  <div class="rte">{{ article.content }}</div>
  <p><a class="text-link" href="{{ blog.url }}">← {{ 'blog.back' | t }}</a></p>
</article>
{% schema %}{ "name": "Artigo", "settings": [] }{% endschema %}

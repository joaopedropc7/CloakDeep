<section class="section container">
  <div class="section-head section-head--page">
    <h1 class="section-title">{{ collection.title }}</h1>
  </div>
  {%- if collection.description != blank -%}<div class="rte collection-desc">{{ collection.description }}</div>{%- endif -%}
  {%- paginate collection.products by section.settings.per_page -%}
    <div class="grid grid--3">
      {%- for product in collection.products -%}
        {% render 'giveaway-card', product: product, mode: section.settings.mode %}
      {%- else -%}
        <p class="muted">No giveaways in this collection yet.</p>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}<nav class="pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
  {%- endpaginate -%}
</section>
{% schema %}
{
  "name": "Coleção",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Itens por página", "min": 6, "max": 48, "step": 3, "default": 18 },
    { "type": "select", "id": "mode", "label": "Estilo do card", "options": [{ "value": "active", "label": "Sorteio ativo" }, { "value": "result", "label": "Resultado" }], "default": "active" }
  ]
}
{% endschema %}

<section class="stories stories--page">
  <div class="container">
    <div class="section-head section-head--page">
      <h1 class="section-title">{{ blog.title }}</h1>
    </div>
    {%- paginate blog.articles by 12 -%}
      <div class="grid grid--3 stories__grid">
        {%- for article in blog.articles -%}
          {%- assign words = article.content | strip_html | split: ' ' | size -%}
          {%- assign minutes = words | divided_by: 200 | at_least: 1 -%}
          <article class="story">
            <a class="story__media" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
              {%- if article.image -%}{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(min-width: 990px) 33vw, 100vw', alt: article.title }}{%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag: 'story__placeholder' }}{%- endif -%}
            </a>
            <h2 class="story__title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
            <p class="story__meta">{{ minutes }} {{ section.settings.read_label }} <span aria-hidden="true">•</span> {{ article.published_at | date: '%m/%d/%Y' }} <span aria-hidden="true">•</span> {{ blog.title }}</p>
          </article>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<nav class="pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>
{% schema %}
{
  "name": "Blog",
  "settings": [
    { "type": "text", "id": "read_label", "label": "Texto do tempo de leitura", "default": "minute read" }
  ]
}
{% endschema %}

<footer class="site-footer">
  {%- if section.settings.show_feedback -%}
    <div class="footer-feedback">
      <div class="container footer-feedback__inner">
        <a href="{{ routes.root_url }}" class="footer-feedback__logo">
          {%- if section.settings.logo != blank -%}
            {{ section.settings.logo | image_url: width: 400 | image_tag: alt: shop.name, loading: 'lazy' }}
          {%- else -%}
            <span class="site-logo__text">{{ shop.name }}</span>
          {%- endif -%}
        </a>
        <div class="footer-feedback__text">
          <p class="footer-feedback__heading">{{ section.settings.feedback_heading }}</p>
          <p>{{ section.settings.feedback_text }}</p>
        </div>
        {%- if section.settings.feedback_button != blank -%}
          <a class="btn btn--outline-blue" href="{{ section.settings.feedback_url | default: '#' }}">{{ section.settings.feedback_button }}</a>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <div class="container">
    <div class="footer-row">
      <div class="footer-col">
        <p class="footer-label">{{ section.settings.social_heading }}</p>
        <ul class="social-list">
          {%- assign socials = 'facebook,instagram,pinterest,tiktok,x,youtube' | split: ',' -%}
          {%- for s in socials -%}
            {%- assign key = 'social_' | append: s -%}
            {%- if settings[key] != blank -%}
              <li><a href="{{ settings[key] }}" target="_blank" rel="noopener" aria-label="{{ s }}">{% render 'icon', name: s %}</a></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
      {%- if section.settings.show_payment -%}
        <div class="footer-col">
          <p class="footer-label">{{ section.settings.payment_heading }}</p>
          <ul class="payment-list">
            {%- if section.settings.payment_types != blank -%}
              {%- assign pay_types = section.settings.payment_types | remove: ' ' | split: ',' -%}
            {%- else -%}
              {%- assign pay_types = shop.enabled_payment_types -%}
            {%- endif -%}
            {%- for type in pay_types -%}
              <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
      {%- if section.settings.app_store_url != blank or section.settings.play_store_url != blank -%}
        <div class="footer-col">
          <p class="footer-label">{{ section.settings.app_heading }}</p>
          <div class="app-badges">
            {%- if section.settings.app_store_url != blank -%}
              <a class="app-badge" href="{{ section.settings.app_store_url }}" target="_blank" rel="noopener">{% render 'icon', name: 'apple' %}<span><small>Download on the</small>App Store</span></a>
            {%- endif -%}
            {%- if section.settings.play_store_url != blank -%}
              <a class="app-badge" href="{{ section.settings.play_store_url }}" target="_blank" rel="noopener">{% render 'icon', name: 'google-play' %}<span><small>Get it on</small>Google Play</span></a>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </div>

    <div class="footer-links-row">
      <nav class="footer-links">
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      </nav>
      {%- if section.settings.phone != blank -%}
        <a class="footer-phone" href="tel:{{ section.settings.phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' }}">
          <span class="footer-phone__icon">{% render 'icon', name: 'phone' %}</span>
          <span><span class="footer-phone__label">{{ section.settings.phone_label }}</span><span class="footer-phone__number">{{ section.settings.phone }}</span></span>
        </a>
      {%- endif -%}
    </div>

    {%- if section.settings.disclaimer_title != blank or section.settings.disclaimer != blank -%}
      <div class="footer-legal-row">
        <div class="footer-legal">
          {%- if section.settings.disclaimer_title != blank -%}<p class="footer-legal__title">{{ section.settings.disclaimer_title }}</p>{%- endif -%}
          <div class="rte">{{ section.settings.disclaimer }}</div>
          {%- if section.settings.rules_link_label != blank -%}
            <p class="footer-legal__link"><a href="{{ section.settings.rules_link_url | default: '#' }}">{{ section.settings.rules_link_label }}</a></p>
          {%- endif -%}
        </div>
        {%- if section.settings.partner_logo != blank -%}
          <a class="footer-partner" href="{{ section.settings.partner_url | default: '#' }}" target="_blank" rel="noopener">
            {{ section.settings.partner_logo | image_url: width: 500 | image_tag: loading: 'lazy', alt: section.settings.partner_logo.alt }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <p class="footer-copy">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
  </div>
</footer>

{% schema %}
{
  "name": "Rodapé",
  "class": "section-footer",
  "settings": [
    { "type": "header", "content": "Faixa de feedback" },
    { "type": "checkbox", "id": "show_feedback", "label": "Mostrar", "default": true },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "feedback_heading", "label": "Título", "default": "How are we doing?" },
    { "type": "text", "id": "feedback_text", "label": "Texto", "default": "We would love to know what you think about our store!" },
    { "type": "text", "id": "feedback_button", "label": "Texto do botão", "default": "GIVE FEEDBACK" },
    { "type": "url", "id": "feedback_url", "label": "Link do botão" },
    { "type": "header", "content": "Redes, pagamento e app" },
    { "type": "text", "id": "social_heading", "label": "Título redes sociais", "default": "Follow us:", "info": "Links configurados em Configurações do tema > Redes sociais." },
    { "type": "checkbox", "id": "show_payment", "label": "Mostrar formas de pagamento", "default": true },
    { "type": "text", "id": "payment_heading", "label": "Título pagamento", "default": "We accept these payment methods:" },
    { "type": "text", "id": "payment_types", "label": "Ícones de pagamento", "default": "visa,master,american_express,discover,paypal,apple_pay", "info": "Separados por vírgula. Deixe vazio para mostrar as formas ativas na loja automaticamente." },
    { "type": "text", "id": "app_heading", "label": "Título app", "default": "Download our app:" },
    { "type": "url", "id": "app_store_url", "label": "Link App Store" },
    { "type": "url", "id": "play_store_url", "label": "Link Google Play" },
    { "type": "header", "content": "Links e contato" },
    { "type": "link_list", "id": "menu", "label": "Menu do rodapé", "default": "footer" },
    { "type": "text", "id": "phone_label", "label": "Rótulo do telefone", "default": "ORDER BY PHONE:" },
    { "type": "text", "id": "phone", "label": "Telefone" },
    { "type": "header", "content": "Avisos legais" },
    { "type": "text", "id": "disclaimer_title", "label": "Aviso em destaque", "default": "NO PURCHASE OR PAYMENT IS NECESSARY TO ENTER OR WIN. MAKING ONE WILL NOT INCREASE YOUR CHANCES OF WINNING." },
    { "type": "text", "id": "rules_link_label", "label": "Link abaixo do texto legal", "default": "Rules and dates can be found here." },
    { "type": "url", "id": "rules_link_url", "label": "Destino do link" },
    { "type": "image_picker", "id": "partner_logo", "label": "Logo de parceiro (à direita do texto legal)" },
    { "type": "url", "id": "partner_url", "label": "Link do logo de parceiro" },
    { "type": "richtext", "id": "disclaimer", "label": "Texto legal", "default": "<p>Replace this text with a summary of your official rules: who is eligible, how odds are calculated, the free method of entry, the sponsor's name and address, and links to your full official rules, privacy policy and terms.</p>" }
  ]
}
{% endschema %}

{%- liquid
  assign p = section.settings.product
  if p != blank
    assign mf = p.metafields.custom
    assign end_date = mf.end_date.value
  endif
  assign hero_img = section.settings.image | default: p.featured_image
  assign number_line = section.settings.number_label | replace: '[number]', mf.giveaway_number
-%}
<section class="split-hero">
  <div class="split-hero__left">
    <div class="split-hero__content">
      {%- if section.settings.show_mark and settings.logo_mark != blank -%}
        {{ settings.logo_mark | image_url: width: 600 | image_tag: class: 'split-hero__mark', alt: '', loading: 'eager' }}
      {%- endif -%}
      <h1 class="split-hero__title">{{ section.settings.title | default: p.title | default: shop.name }}</h1>
      {%- if end_date != blank -%}
        <p class="split-hero__ends">{{ number_line }}</p>
        <p class="split-hero__countdown">{% render 'countdown', end: end_date, style: 'inline' %}</p>
      {%- endif -%}
      <div class="split-hero__buttons">
        {%- if section.settings.primary_label != blank -%}
          <a class="btn btn--red split-hero__btn" href="{% if p != blank %}{{ p.url }}#donation{% else %}{{ routes.all_products_collection_url }}{% endif %}">{{ section.settings.primary_label }}</a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank and p != blank -%}
          <a class="btn btn--outline-blue split-hero__btn" href="{{ p.url }}">{{ section.settings.secondary_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
  <a class="split-hero__media" href="{% if p != blank %}{{ p.url }}{% else %}#{% endif %}" tabindex="-1" aria-hidden="true">
    {%- if hero_img -%}
      {{ hero_img | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600,900,1200,1800', sizes: '(min-width: 990px) 50vw, 100vw', alt: '' }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'split-hero__placeholder' }}
    {%- endif -%}
  </a>
</section>

{% schema %}
{
  "name": "Destaque do sorteio",
  "settings": [
    { "type": "product", "id": "product", "label": "Sorteio em destaque" },
    { "type": "image_picker", "id": "image", "label": "Imagem da direita", "info": "Se vazio, usa a imagem principal do produto." },
    { "type": "checkbox", "id": "show_mark", "label": "Mostrar emblema acima do título", "default": true, "info": "Emblema definido em Configurações do tema > Marca." },
    { "type": "text", "id": "title", "label": "Título", "info": "Se vazio, usa o nome do produto." },
    { "type": "text", "id": "number_label", "label": "Texto acima da contagem", "default": "Giveaway No. [number] ends in:", "info": "[number] é trocado pelo número do sorteio." },
    { "type": "text", "id": "primary_label", "label": "Botão principal", "default": "ENTER NOW" },
    { "type": "text", "id": "secondary_label", "label": "Botão secundário", "default": "PRIZE DETAILS" }
  ],
  "presets": [{ "name": "Destaque do sorteio" }]
}
{% endschema %}

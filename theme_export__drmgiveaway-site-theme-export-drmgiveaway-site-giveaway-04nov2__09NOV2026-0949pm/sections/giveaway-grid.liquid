{%- liquid
  assign coll = section.settings.collection
  assign mode = section.settings.mode
  if coll != blank
    assign source = coll.products
  else
    assign source = collections.all.products
  endif
  assign shown = 0
-%}
<section class="gsection gsection--{{ section.settings.background }} gsection--{{ mode }}">
  <div class="container">
    {%- if section.settings.intro_heading != blank or section.settings.intro_text != blank -%}
      <div class="gsection__intro">
        {%- if section.settings.intro_heading != blank -%}<h2 class="gsection__intro-title">{{ section.settings.intro_heading }}</h2>{%- endif -%}
        {%- if section.settings.intro_text != blank -%}<div class="gsection__intro-text">{{ section.settings.intro_text }}</div>{%- endif -%}
      </div>
    {%- endif -%}
    {%- if section.settings.heading != blank or section.settings.link_label != blank -%}
      <div class="section-head">
        {%- if section.settings.heading != blank -%}<h2 class="section-title">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.link_label != blank -%}
          <a class="section-link" href="{{ section.settings.link_url | default: coll.url | default: routes.all_products_collection_url }}">{{ section.settings.link_label }} {% render 'icon', name: 'arrow-right' %}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
    <div class="grid grid--{{ section.settings.columns }}">
      {%- for product in source -%}
        {%- if shown >= section.settings.limit -%}{%- break -%}{%- endif -%}
        {%- if coll == blank -%}
          {%- liquid
            assign _end = product.metafields.custom.end_date.value
            assign giveaway_ended = false
            if _end != blank
              assign _now = 'now' | date: '%s' | plus: 0
              assign _e = _end | date: '%s' | plus: 0
              if _now > _e
                assign giveaway_ended = true
              endif
            endif
          -%}
          {%- if mode == 'result' and giveaway_ended == false -%}{%- continue -%}{%- endif -%}
          {%- if mode != 'result' and giveaway_ended -%}{%- continue -%}{%- endif -%}
        {%- endif -%}
        {%- assign shown = shown | plus: 1 -%}
        {%- case mode -%}
          {%- when 'tile' -%}{% render 'giveaway-tile', product: product %}
          {%- when 'result' -%}{% render 'result-card', product: product, section: section %}
          {%- else -%}{% render 'giveaway-card', product: product, mode: 'active' %}
        {%- endcase -%}
      {%- endfor -%}
      {%- if shown == 0 -%}
        {%- assign cols = section.settings.columns | plus: 0 -%}
        {%- for i in (1..cols) -%}
          {%- if mode == 'result' -%}
            <article class="rcard rcard--placeholder">
              <div class="rcard__media">{{ 'product-1' | placeholder_svg_tag: 'gtile__placeholder' }}</div>
              <div class="rcard__body">
                <div class="rcard__meta">
                  {%- if settings.logo_mark != blank -%}{{ settings.logo_mark | image_url: width: 300 | image_tag: class: 'rcard__mark', alt: '', loading: 'lazy' }}{%- else -%}<span></span>{%- endif -%}
                  <span class="rcard__info"><span>{{ 'giveaway.number' | t }} 00{{ i }}</span><span>{{ 'now' | date: '%b %-d, %Y' }}</span></span>
                </div>
                <h3 class="rcard__title"><span>Prize name</span></h3>
                <p class="rcard__status-label">{{ section.settings.status_label }}</p>
                <span class="rcard__status">{{ section.settings.status_pending }}</span>
                {%- if section.settings.button_label != blank -%}<span class="rcard__link">{{ section.settings.button_label }}</span>{%- endif -%}
              </div>
            </article>
            {%- continue -%}
          {%- endif -%}
          <article class="gtile">
            <div class="gtile__media">{{ 'product-1' | placeholder_svg_tag: 'gtile__placeholder' }}</div>
            <div class="gtile__body"><h3 class="gtile__title">Prize name</h3><p class="gtile__number">Giveaway No. 00{{ i }}</p></div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Grade de sorteios",
  "settings": [
    { "type": "header", "content": "Introdução (opcional)" },
    { "type": "text", "id": "intro_heading", "label": "Título central" },
    { "type": "richtext", "id": "intro_text", "label": "Texto central" },
    { "type": "header", "content": "Grade" },
    { "type": "text", "id": "heading", "label": "Título da grade" },
    { "type": "text", "id": "link_label", "label": "Link à direita do título", "info": "Ex.: All Results" },
    { "type": "url", "id": "link_url", "label": "Destino do link" },
    { "type": "collection", "id": "collection", "label": "Coleção", "info": "Se vazio, usa todos os produtos: sorteios abertos nos estilos 'Card com emblema' e 'Card simples', e encerrados no estilo 'Resultado'." },
    {
      "type": "select", "id": "mode", "label": "Estilo dos cards",
      "options": [
        { "value": "tile", "label": "Card com emblema (sorteios abertos)" },
        { "value": "result", "label": "Resultado (sorteios encerrados)" },
        { "value": "active", "label": "Card simples com contagem" }
      ],
      "default": "tile"
    },
    { "type": "range", "id": "limit", "label": "Quantidade", "min": 1, "max": 24, "step": 1, "default": 9 },
    { "type": "select", "id": "columns", "label": "Colunas", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }], "default": "3" },
    { "type": "select", "id": "background", "label": "Fundo", "options": [{ "value": "white", "label": "Branco" }, { "value": "gray", "label": "Cinza" }], "default": "gray" },
    { "type": "header", "content": "Estilo Resultado" },
    { "type": "text", "id": "status_label", "label": "Rótulo do status", "default": "Giveaway status" },
    { "type": "text", "id": "status_pending", "label": "Status: encerrado, aguardando sorteio", "default": "GIVEAWAY CLOSED - RESULTS PENDING" },
    { "type": "text", "id": "status_drawn", "label": "Status: sorteio realizado", "default": "WINNER SELECTED" },
    { "type": "text", "id": "button_label", "label": "Link do card", "default": "View Draw Results" },
    { "type": "url", "id": "results_url", "label": "Destino do link do card", "info": "Se vazio, abre a página do sorteio." }
  ],
  "presets": [{ "name": "Grade de sorteios" }]
}
{% endschema %}

<section class="section container page-narrow center">
  <h1 class="section-title">{{ shop.name }}</h1>
  <p>{{ shop.password_message | default: 'password.title' | t }}</p>
  {%- form 'storefront_password', class: 'search-form' -%}
    {{ form.errors | default_errors }}
    <input type="password" name="password" placeholder="Password" required>
    <button class="btn btn--red" type="submit">{{ 'password.submit' | t }}</button>
  {%- endform -%}
</section>
{% schema %}{ "name": "Senha", "settings": [] }{% endschema %}

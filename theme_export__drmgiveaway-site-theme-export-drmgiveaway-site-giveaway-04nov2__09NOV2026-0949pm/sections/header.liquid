<header class="site-header" data-header>
  <div class="container site-header__inner">
    <button class="menu-toggle" type="button" aria-controls="menu-drawer" aria-expanded="false" data-drawer-open>
      {% render 'icon', name: 'menu' %}
      <span class="menu-toggle__label">{{ 'general.menu' | t }}</span>
    </button>

    <a href="{{ routes.root_url }}" class="site-logo" style="--logo-width: {{ section.settings.logo_width }}px;">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 600 | image_tag: alt: shop.name, class: 'site-logo__img', loading: 'eager', widths: '200,300,400,600', sizes: '300px' }}
      {%- else -%}
        <span class="site-logo__text">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <nav class="site-nav" aria-label="Main">
      {%- for link in section.settings.menu.links -%}
        {%- assign is_gw = false -%}
        {%- if section.settings.gw_enable and link.title == section.settings.gw_link_title -%}{%- assign is_gw = true -%}{%- endif -%}
        <a href="{{ link.url }}" class="site-nav__link{% if link.active %} is-active{% endif %}"{% if is_gw %} data-gw-open aria-controls="menu-drawer"{% endif %}>{{ link.title }}</a>
      {%- endfor -%}
    </nav>

    <div class="site-header__icons">
      {%- if shop.customer_accounts_enabled and section.settings.show_account -%}
        <a class="header-icon" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">
          {% render 'icon', name: 'user' %}
          <span class="header-icon__label">{% if customer %}{{ 'general.account' | t }}{% else %}{{ 'general.login' | t }}{% endif %}</span>
        </a>
      {%- endif -%}
      <a class="header-icon" href="{{ routes.cart_url }}">
        <span class="header-icon__cart">
          {% render 'icon', name: 'cart' %}
          <span class="cart-count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
        </span>
        <span class="header-icon__label">{{ 'general.cart' | t }}</span>
      </a>
    </div>
  </div>
</header>

{%- liquid
  assign gw_coll = section.settings.gw_collection
  if gw_coll == blank
    assign gw_coll = collections['giveaways']
  endif
  if gw_coll == blank or gw_coll.products_count == 0
    assign gw_source = collections.all.products
    assign gw_url = routes.all_products_collection_url
  else
    assign gw_source = gw_coll.products
    assign gw_url = gw_coll.url
  endif
  assign now_s = 'now' | date: '%s' | plus: 0
  assign soon_s = section.settings.gw_soon_days | times: 86400
-%}
<div class="drawer" id="menu-drawer" data-drawer hidden>
  <div class="drawer__overlay" data-drawer-close></div>
  <div class="drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'general.menu' | t }}">
    <div class="drawer__head">
      <a href="{{ routes.root_url }}" class="drawer__logo">
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: 400 | image_tag: alt: shop.name, loading: 'lazy' }}
        {%- else -%}
          <span class="drawer__title">{{ shop.name }}</span>
        {%- endif -%}
      </a>
      <button type="button" class="icon-btn drawer__x" data-drawer-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </div>

    <div class="drawer__view" data-drawer-view="main">
      <nav class="drawer__nav">
        {%- assign drawer_menu = section.settings.drawer_menu | default: section.settings.menu -%}
        {%- for link in drawer_menu.links -%}
          {%- if section.settings.gw_enable and link.title == section.settings.gw_link_title -%}
            <a href="{{ link.url }}" class="drawer__link drawer__link--sub" data-gw-open>{{ link.title }} {% render 'icon', name: 'chevron-right' %}</a>
          {%- else -%}
            <a href="{{ link.url }}" class="drawer__link">{{ link.title }}</a>
          {%- endif -%}
          {%- for child in link.links -%}
            <a href="{{ child.url }}" class="drawer__link drawer__link--child">{{ child.title }}</a>
          {%- endfor -%}
        {%- endfor -%}
      </nav>
    </div>

    {%- if section.settings.gw_enable -%}
      <div class="drawer__view" data-drawer-view="giveaways" hidden>
        <div class="gw-head">
          <button type="button" class="gw-head__back" data-gw-back aria-label="{{ 'general.back' | t }}">{% render 'icon', name: 'arrow-left' %}</button>
          <h2 class="gw-head__title">{{ section.settings.gw_link_title }}</h2>
          {%- if section.settings.gw_view_all != blank -%}
            <a class="gw-head__all" href="{{ section.settings.gw_view_all_url | default: routes.root_url }}">{{ section.settings.gw_view_all }} {% render 'icon', name: 'arrow-right' %}</a>
          {%- endif -%}
        </div>
        <div class="gw-list">
          {%- assign gw_shown = 0 -%}
          {%- for product in gw_source -%}
            {%- if gw_shown >= section.settings.gw_limit -%}{%- break -%}{%- endif -%}
            {%- liquid
              assign _end = product.metafields.custom.end_date.value
              assign soon = false
              if _end != blank
                assign _e = _end | date: '%s' | plus: 0
                if now_s > _e
                  continue
                endif
                assign left = _e | minus: now_s
                if left <= soon_s
                  assign soon = true
                endif
              endif
              assign gw_shown = gw_shown | plus: 1
            -%}
            <a class="gw-card" href="{{ product.url }}">
              <span class="gw-card__media">
                {%- if product.featured_image -%}
                  {{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350,500,700', sizes: '(max-width: 749px) 55vw, 280px', alt: product.title }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'gtile__placeholder' }}
                {%- endif -%}
                {%- if soon and section.settings.gw_soon_label != blank -%}<span class="gw-card__badge">{{ section.settings.gw_soon_label }}</span>{%- endif -%}
              </span>
              <span class="gw-card__info">
                {%- if settings.logo_mark != blank -%}{{ settings.logo_mark | image_url: width: 240 | image_tag: class: 'gw-card__mark', alt: '', loading: 'lazy' }}{%- endif -%}
                {%- if product.metafields.custom.prize_value != blank -%}<span class="gw-card__value">{{ product.metafields.custom.prize_value }}</span>{%- endif -%}
                {%- if product.metafields.custom.giveaway_number != blank -%}<span class="gw-card__number">{{ 'giveaway.number' | t }} {{ product.metafields.custom.giveaway_number }}</span>{%- endif -%}
              </span>
            </a>
          {%- endfor -%}
          {%- if gw_shown == 0 -%}<p class="gw-list__empty">{{ section.settings.gw_empty }}</p>{%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Cabeçalho",
  "class": "section-header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_width", "label": "Largura do logo", "min": 80, "max": 320, "step": 10, "unit": "px", "default": 220 },
    { "type": "link_list", "id": "menu", "label": "Menu principal", "default": "main-menu" },
    { "type": "link_list", "id": "drawer_menu", "label": "Menu lateral (botão Menu)", "info": "Se vazio, usa o menu principal." },
    { "type": "checkbox", "id": "show_account", "label": "Mostrar link de login/conta", "default": true },
    { "type": "header", "content": "Barra lateral de sorteios" },
    { "type": "checkbox", "id": "gw_enable", "label": "Abrir barra lateral ao clicar no link de sorteios", "default": true },
    { "type": "text", "id": "gw_link_title", "label": "Nome do link no menu", "default": "Giveaways", "info": "O item do menu com esse nome abre a barra em vez de ir para a coleção." },
    { "type": "collection", "id": "gw_collection", "label": "Coleção", "info": "Se vazio, usa a coleção 'giveaways'. Só aparecem sorteios abertos." },
    { "type": "range", "id": "gw_limit", "label": "Quantidade máxima", "min": 2, "max": 20, "step": 1, "default": 10 },
    { "type": "text", "id": "gw_view_all", "label": "Texto do link VIEW ALL", "default": "VIEW ALL" },
    { "type": "url", "id": "gw_view_all_url", "label": "Destino do VIEW ALL", "info": "Se vazio, vai para a página inicial." },
    { "type": "text", "id": "gw_soon_label", "label": "Selo de encerramento", "default": "ENDING SOON" },
    { "type": "range", "id": "gw_soon_days", "label": "Mostrar selo quando faltarem até", "min": 1, "max": 30, "step": 1, "unit": "d", "default": 7 },
    { "type": "text", "id": "gw_empty", "label": "Texto sem sorteios abertos", "default": "New giveaways coming soon." }
  ]
}
{% endschema %}

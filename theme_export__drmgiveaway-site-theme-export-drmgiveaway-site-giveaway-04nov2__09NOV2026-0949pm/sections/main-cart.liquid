<section class="section container cart-page">
  <h1 class="section-title">{{ 'cart.title' | t }}</h1>
  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" class="cart-form">
      <div class="cart-items">
        {%- for item in cart.items -%}
          <div class="cart-item">
            <a class="cart-item__media" href="{{ item.url }}">
              {%- if item.image -%}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy' }}{%- endif -%}
            </a>
            <div class="cart-item__info">
              <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}<p class="muted">{{ item.variant.title }}</p>{%- endunless -%}
              <p class="cart-item__price">{{ item.final_line_price | money }}</p>
              {%- for discount in item.line_level_discount_allocations -%}<p class="muted">{{ discount.discount_application.title }} (−{{ discount.amount | money }})</p>{%- endfor -%}
            </div>
            <div class="cart-item__qty">
              <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity">
              <a href="{{ item.url_to_remove }}" class="text-link">{{ 'cart.remove' | t }}</a>
            </div>
          </div>
        {%- endfor -%}
      </div>
      <div class="cart-summary">
        {%- for discount in cart.cart_level_discount_applications -%}<p class="muted">{{ discount.title }} (−{{ discount.total_allocated_amount | money }})</p>{%- endfor -%}
        <p class="cart-summary__total"><span>{{ 'cart.subtotal' | t }}</span><strong>{{ cart.total_price | money_with_currency }}</strong></p>
        <p class="muted">{{ 'cart.taxes' | t }}</p>
        <div class="cart-summary__actions">
          <button type="submit" name="update" class="btn btn--outline">{{ 'cart.update' | t }}</button>
          <button type="submit" name="checkout" class="btn btn--red btn--lg">{{ 'cart.checkout' | t }}</button>
        </div>
      </div>
    </form>
  {%- else -%}
    <p>{{ 'cart.empty' | t }}</p>
    <a class="btn btn--red" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
  {%- endif -%}
</section>
{% schema %}{ "name": "Carrinho", "settings": [] }{% endschema %}

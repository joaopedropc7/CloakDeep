<section class="ifeat">
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="ifeat__intro">
        {%- if section.settings.heading != blank -%}<h2 class="ifeat__title">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<div class="ifeat__text">{{ section.settings.text }}</div>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="ifeat__grid">
      <div class="ifeat__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '500,800,1100,1400', sizes: '(min-width: 990px) 50vw, 100vw' }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'ifeat__placeholder' }}
        {%- endif -%}
      </div>
      <div class="ifeat__list">
        {%- for block in section.blocks -%}
          <div class="ifeat__item" {{ block.shopify_attributes }}>
            {%- if block.settings.title != blank -%}<h3 class="ifeat__item-title">{{ block.settings.title }}</h3>{%- endif -%}
            {%- if block.settings.text != blank -%}<div class="ifeat__item-text">{{ block.settings.text }}</div>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Imagem com benefícios",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título central" },
    { "type": "richtext", "id": "text", "label": "Texto central" },
    { "type": "image_picker", "id": "image", "label": "Imagem da esquerda", "info": "Use uma imagem já montada (por exemplo, foto com logos de parceiros). PNG com fundo transparente fica melhor." }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Benefício",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Feature title" },
        { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Describe this benefit.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "Imagem com benefícios", "blocks": [{ "type": "feature" }, { "type": "feature" }, { "type": "feature" }] }]
}
{% endschema %}

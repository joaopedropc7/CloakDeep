{%- assign blog = section.settings.blog -%}
<section class="stories">
  <div class="container">
    <div class="section-head">
      {%- if section.settings.heading != blank -%}<h2 class="section-title">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <a class="section-link" href="{{ section.settings.link_url | default: blog.url | default: '#' }}">{{ section.settings.link_label }} {% render 'icon', name: 'arrow-right' %}</a>
      {%- endif -%}
    </div>
    <div class="grid grid--3 stories__grid">
      {%- if blog != blank and blog.articles_count > 0 -%}
        {%- for article in blog.articles limit: section.settings.limit -%}
          {%- assign words = article.content | strip_html | split: ' ' | size -%}
          {%- assign minutes = words | divided_by: 200 | at_least: 1 -%}
          <article class="story">
            <a class="story__media" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
              {%- if article.image -%}{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(min-width: 990px) 33vw, 100vw', alt: article.title }}{%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag: 'story__placeholder' }}{%- endif -%}
            </a>
            <h3 class="story__title"><a href="{{ article.url }}">{{ article.title }}</a></h3>
            <p class="story__meta">{{ minutes }} {{ section.settings.read_label }} <span aria-hidden="true">•</span> {{ article.published_at | date: '%m/%d/%Y' }} <span aria-hidden="true">•</span> <a href="{{ blog.url }}">{{ blog.title }}</a></p>
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <article class="story">
            <div class="story__media">{{ 'lifestyle-2' | placeholder_svg_tag: 'story__placeholder' }}</div>
            <h3 class="story__title">Winner story title</h3>
            <p class="story__meta">1 {{ section.settings.read_label }} • 01/01/2026 • Winner Stories</p>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Histórias de ganhadores",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Winner Stories" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "limit", "label": "Quantidade", "min": 3, "max": 9, "step": 3, "default": 3 },
    { "type": "text", "id": "link_label", "label": "Texto do link", "default": "All Winner Stories" },
    { "type": "url", "id": "link_url", "label": "Destino do link", "info": "Se vazio, usa o blog escolhido." },
    { "type": "text", "id": "read_label", "label": "Texto do tempo de leitura", "default": "minute read" }
  ],
  "presets": [{ "name": "Histórias de ganhadores" }]
}
{% endschema %}

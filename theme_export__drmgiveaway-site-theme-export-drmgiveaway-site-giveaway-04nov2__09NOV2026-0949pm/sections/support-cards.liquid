<section class="support">
  <div class="container">
    {%- if section.settings.divider -%}<hr class="support__divider">{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="support__title">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.subheading != blank -%}<p class="support__sub">{{ section.settings.subheading }}</p>{%- endif -%}
    <div class="support__grid">
      {%- for block in section.blocks -%}
        <div class="support-card" {{ block.shopify_attributes }}>
          <div class="support-card__icon">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: '' }}
            {%- else -%}
              {% render 'icon', name: block.settings.fallback_icon %}
            {%- endif -%}
          </div>
          <div class="support-card__body">
            {%- if block.settings.title != blank -%}<h3 class="support-card__title">{{ block.settings.title }}</h3>{%- endif -%}
            {%- if block.settings.text != blank -%}<div class="support-card__text">{{ block.settings.text }}</div>{%- endif -%}
            <div class="support-card__links">
              {%- if block.settings.link1_label != blank -%}
                <a href="{{ block.settings.link1_url | default: '#' }}">{%- if block.settings.link1_icon != 'none' -%}{% render 'icon', name: block.settings.link1_icon %}{%- endif -%} {{ block.settings.link1_label }}</a>
              {%- endif -%}
              {%- if block.settings.link2_label != blank -%}
                <a href="{{ block.settings.link2_url | default: '#' }}">{%- if block.settings.link2_icon != 'none' -%}{% render 'icon', name: block.settings.link2_icon %}{%- endif -%} {{ block.settings.link2_label }}</a>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Cards de atendimento",
  "settings": [
    { "type": "checkbox", "id": "divider", "label": "Linha divisória no topo", "default": true },
    { "type": "text", "id": "heading", "label": "Título", "default": "Customer Support" },
    { "type": "text", "id": "subheading", "label": "Subtítulo", "default": "Have a question or need help? Contact our support team." }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Ícone/ilustração (círculo)" },
        { "type": "select", "id": "fallback_icon", "label": "Ícone padrão (sem imagem)", "options": [{ "value": "phone", "label": "Telefone" }, { "value": "email", "label": "E-mail" }, { "value": "help", "label": "Ajuda" }, { "value": "cart", "label": "Carrinho" }], "default": "help" },
        { "type": "text", "id": "title", "label": "Título", "default": "Talk to our Support Team" },
        { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Got a question? Get in touch with our support team.</p>" },
        { "type": "text", "id": "link1_label", "label": "Link 1: texto", "default": "CALL US" },
        { "type": "url", "id": "link1_url", "label": "Link 1: destino", "info": "Para telefone use tel:+1XXXXXXXXXX" },
        { "type": "select", "id": "link1_icon", "label": "Link 1: ícone", "options": [{ "value": "phone", "label": "Telefone" }, { "value": "email", "label": "E-mail" }, { "value": "none", "label": "Nenhum" }], "default": "phone" },
        { "type": "text", "id": "link2_label", "label": "Link 2: texto", "default": "EMAIL US" },
        { "type": "url", "id": "link2_url", "label": "Link 2: destino", "info": "Para e-mail use mailto:seu@email.com" },
        { "type": "select", "id": "link2_icon", "label": "Link 2: ícone", "options": [{ "value": "phone", "label": "Telefone" }, { "value": "email", "label": "E-mail" }, { "value": "none", "label": "Nenhum" }], "default": "email" }
      ]
    }
  ],
  "presets": [{ "name": "Cards de atendimento", "blocks": [{ "type": "card" }, { "type": "card" }] }]
}
{% endschema %}

<section class="contact-strip">
  <div class="container contact-strip__inner">
    {%- if section.settings.heading != blank -%}<p class="contact-strip__heading">{{ section.settings.heading }}</p>{%- endif -%}
    <div class="contact-strip__buttons">
      {%- for block in section.blocks -%}
        <a class="contact-strip__btn" href="{{ block.settings.url | default: '#' }}" {{ block.shopify_attributes }}>
          {% render 'icon', name: block.settings.icon %}<span>{{ block.settings.label }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Faixa de contato",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Questions? Get in touch" }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Botão",
      "settings": [
        { "type": "select", "id": "icon", "label": "Ícone", "options": [{ "value": "phone", "label": "Telefone" }, { "value": "email", "label": "E-mail" }, { "value": "help", "label": "Ajuda" }], "default": "phone" },
        { "type": "text", "id": "label", "label": "Texto", "default": "Call us" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "presets": [{
    "name": "Faixa de contato",
    "blocks": [
      { "type": "button", "settings": { "icon": "phone", "label": "Call us" } },
      { "type": "button", "settings": { "icon": "email", "label": "Email us" } },
      { "type": "button", "settings": { "icon": "help", "label": "FAQs" } }
    ]
  }]
}
{% endschema %}

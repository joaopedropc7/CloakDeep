{%- assign gnum = product.metafields.custom.giveaway_number -%}
<a class="gtile" href="{{ product.url }}">
  <span class="gtile__media">
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw', alt: product.title }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'gtile__placeholder' }}
    {%- endif -%}
    {%- if settings.logo_mark != blank -%}
      <span class="gtile__badge">{{ settings.logo_mark | image_url: width: 300 | image_tag: loading: 'lazy', alt: '' }}</span>
    {%- endif -%}
  </span>
  <span class="gtile__body">
    <span class="gtile__title">{{ product.title }}</span>
    {%- if gnum != blank -%}<span class="gtile__number">{{ 'giveaway.number' | t }} {{ gnum }}</span>{%- endif -%}
  </span>
</a>

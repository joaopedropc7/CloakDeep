{%- comment -%}
  Params: end (date), style ('inline' | 'boxes')
{%- endcomment -%}
{%- if end != blank -%}
  {%- assign iso = end | date: '%Y-%m-%dT%H:%M:%S%z' -%}
  {%- if style == 'boxes' -%}
    <div class="countdown countdown--boxes" data-countdown="{{ iso }}" data-ended-label="{{ settings.ended_label | escape }}">
      <div class="countdown__box"><span class="countdown__num" data-d>0</span><span class="countdown__unit">{{ settings.cd_days }}</span></div>
      <div class="countdown__box"><span class="countdown__num" data-h>00</span><span class="countdown__unit">{{ settings.cd_hours }}</span></div>
      <div class="countdown__box"><span class="countdown__num" data-m>00</span><span class="countdown__unit">{{ settings.cd_minutes }}</span></div>
      <div class="countdown__box"><span class="countdown__num" data-s>00</span><span class="countdown__unit">{{ settings.cd_seconds }}</span></div>
    </div>
  {%- else -%}
    <span class="countdown countdown--inline" data-countdown="{{ iso }}" data-ended-label="{{ settings.ended_label | escape }}">
      <span data-d>0</span> {{ settings.cd_days }}
      <span data-h>0</span> {{ settings.cd_hours }}
      <span data-m>0</span> {{ settings.cd_minutes }}
      <strong><span data-s>0</span> {{ settings.cd_seconds }}</strong>
    </span>
  {%- endif -%}
{%- endif -%}

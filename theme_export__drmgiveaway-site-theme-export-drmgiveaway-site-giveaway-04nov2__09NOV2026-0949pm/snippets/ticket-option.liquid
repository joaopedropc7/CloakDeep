{%- comment -%}
  Params: variant, product, featured (bool)
{%- endcomment -%}
{%- liquid
  assign badge = variant.metafields.custom.badge.value | default: variant.metafields.custom.badge
  if settings.buy_redirect == 'checkout'
    assign return_to = '/checkout'
  else
    assign return_to = routes.cart_url
  endif
  assign draw_date = product.metafields.custom.draw_date.value
  assign gnum = product.metafields.custom.giveaway_number
  if variant.title == 'Default Title'
    assign label = product.title
  else
    assign label = variant.title
  endif
-%}
<form method="post" action="{{ routes.cart_add_url }}" class="ticket-option{% if featured %} ticket-option--featured{% endif %}" accept-charset="UTF-8"
  {%- if settings.buy_redirect == 'drawer' %}
  data-drawer-add
  data-title="{{ product.title | escape }}"
  data-label="{{ label | escape }}"
  data-price="{{ variant.price | money | escape }}"
  {%- if draw_date != blank %} data-draw="{{ settings.drawer_draw_label | escape }} {{ draw_date | date: '%a, %m/%d/%Y' }}"{% endif %}
  {%- if gnum != blank %} data-number="{{ settings.drawer_number_label | escape }} {{ gnum | escape }}"{% endif %}
  {%- endif %}>
  <input type="hidden" name="form_type" value="product">
  <input type="hidden" name="utf8" value="✓">
  <input type="hidden" name="id" value="{{ variant.id }}">
  <input type="hidden" name="quantity" value="1">
  <input type="hidden" name="return_to" value="{{ return_to }}">
  <button type="submit" class="ticket-option__btn"{% unless variant.available %} disabled{% endunless %}>
    {%- if featured and badge != blank -%}<span class="ticket-option__badge">{{ badge }}</span>{%- endif -%}
    <span class="ticket-option__price">{{ variant.price | money_without_trailing_zeros }}</span>
    <span class="ticket-option__label">{{ label }}</span>
  </button>
</form>

{%- comment -%}
  Params: product, mode ('active' | 'result'), button_label
{%- endcomment -%}
{%- liquid
  assign mf = product.metafields.custom
  assign end_date = mf.end_date.value
  assign draw_date = mf.draw_date.value
-%}
<article class="gcard{% if mode == 'result' %} gcard--result{% endif %}">
  <a class="gcard__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw', alt: product.title }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'gcard__placeholder' }}
    {%- endif -%}
    {%- if mode != 'result' and end_date != blank -%}
      <span class="gcard__badge">{% render 'countdown', end: end_date, style: 'inline' %}</span>
    {%- endif -%}
  </a>
  <div class="gcard__body">
    {%- if mf.giveaway_number != blank -%}
      <p class="gcard__eyebrow">{{ 'giveaway.number' | t }} {{ mf.giveaway_number }}{% if mode == 'result' and draw_date != blank %} · {{ draw_date | date: settings.date_format }}{% endif %}</p>
    {%- endif -%}
    <h3 class="gcard__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
    {%- if mode == 'result' -%}
      {%- if mf.winner != blank -%}<p class="gcard__meta">{{ mf.winner }}</p>{%- endif -%}
      <a class="btn btn--outline btn--block" href="{{ product.url }}">{{ button_label | default: 'giveaway.view' | t }}</a>
    {%- else -%}
      {%- if end_date != blank -%}
        <p class="gcard__meta">{{ 'giveaway.ends' | t }} {{ end_date | date: settings.date_format }}</p>
      {%- endif -%}
      {%- if product.price_min > 0 -%}
        <p class="gcard__price">{{ product.price_min | money_without_trailing_zeros }}+</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</article>

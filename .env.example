# Aplicação
APP_URL=http://localhost:3000
NODE_ENV=development

# Shopify: Client ID/Secret são cadastrados por loja no painel.
SHOPIFY_API_VERSION=2026-10

# Supabase (apenas persistência; use a service_role somente no servidor)
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key

# Gere as chaves com `npm run secrets:generate`.
TOKEN_ENCRYPTION_KEY=base64_de_32_bytes
SESSION_SECRET=string_aleatoria_com_32_ou_mais_caracteres
# Senha inicial; depois troque em /admin/settings (hash scrypt no banco).
ADMIN_PASSWORD=sua_senha_inicial_com_12_ou_mais_caracteres
# Protege /api/cron/sync (Authorization: Bearer ...).
CRON_SECRET=gere_com_o_script_ou_um_valor_aleatorio

# Apenas desenvolvimento local: permite chamadas da vitrine em localhost:3000.
# Nunca habilite em produção.
ALLOW_LOCALHOST_STOREFRONT=false
